---
import { config, withBase, absoluteUrl, appLink } from '../lib/config';
import { siteVersion } from '../lib/version';
import content from '../components/whoop-letter.html?raw';
import '../styles/whoop.css';
const title = 'WHOOP в вашем ChatGPT — Ligos';
const description =
  'Подключите WHOOP к ChatGPT или Claude через Ligos. Сон, Recovery и тренировки — в вашем ИИ без скриншотов. Один сервис бесплатно.';
const canonical = absoluteUrl('/whoop/');
const image = absoluteUrl('/img/og.png?v=ligos-2');
const html = content
  .replace(/(href|src)="(\/[^"]*)"/g, (_, attr, path) => `${attr}="${withBase(path)}"`)
  .replaceAll('https://app.ligos.io/whoop', appLink('/whoop'))
  .replace('__SITE_VERSION__', siteVersion);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  inLanguage: 'ru',
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf9" />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={withBase('/favicon-ligos-square.svg?v=ligos-square-3')}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={withBase('/favicon-32.png?v=ligos-square-3')}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={withBase('/apple-touch-icon.png?v=ligos-square-3')}
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    {config.verification && <meta name="yandex-verification" content={config.verification} />}
    <link
      rel="preload"
      as="font"
      href={withBase('/fonts/onest-cyrillic.woff2')}
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      href={withBase('/fonts/onest-latin.woff2')}
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body data-app={config.app} data-site={config.site} data-ym-id={config.ymId}>
    <Fragment set:html={html} />
    <script>
      import '../scripts/whoop.js';
      import '../scripts/site';
    </script>
  </body>
</html>
