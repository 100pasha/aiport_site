---
import { withBase } from '../lib/config';
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import { config } from '../lib/config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: config.brand,
  operatingSystem: 'Web',
  applicationCategory: 'BusinessApplication',
  offers: [
    { price: 490, priceCurrency: 'RUB' },
    { price: 4000, priceCurrency: 'RUB' },
  ].map((o) => ({ '@type': 'Offer', ...o })),
};
---

<Layout title="Тарифы — все сервисы в одной подписке" schema={schema}>
  <section class="page-hero">
    <div class="container center">
      <span class="eyebrow">БОЛЬШЕ КОНТРОЛЯ. БЕЗ ЛИШНИХ РАСХОДОВ.</span>
      <h1 style="margin:auto">Начните с одного. Подключите больше.</h1>
      <p style="margin-inline:auto">
        Один источник бесплатно навсегда. Для нескольких сервисов — подписка на месяц или год.
      </p>
    </div>
  </section>
  <section class="section pricing-section">
    <div class="container">
      <Pricing />
    </div>
  </section>
  <section class="section">
    <div class="container faq-layout">
      <div class="section-heading">
        <span class="eyebrow">БЕЗ МЕЛКОГО ШРИФТА</span>
        <h2>До первого платежа</h2>
        <p>
          Условия бесплатного доступа, отмены и подписки — в{' '}
          <a class="text-link" href={withBase('/oferta/')}>
            оферте
          </a>
          .
        </p>
      </div>
      <FAQ />
    </div>
  </section>
</Layout>
