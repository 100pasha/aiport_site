---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const faqs = await getCollection('faq');
const topics = ['Начало работы', 'Безопасность', 'ИИ-клиенты', 'Оплата', 'Сервисы'];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.data.title,
    acceptedAnswer: { '@type': 'Answer', text: f.body?.trim() },
  })),
};
---

<Layout
  title="Частые вопросы"
  description="15 ответов о подключении ИИ к бизнесу: начало работы, доступ к данным, безопасность, подписка и поддерживаемые сервисы."
  schema={schema}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">ПОНЯТНО. БЕЗ ТЕХНИЧЕСКОГО СЛОВАРЯ.</span>
      <h1>
        Вопросы, которые
        <br />
        стоит задать.
      </h1>
      <p>Всё важное перед первым подключением.</p>
    </div>
  </section>
  <div class="container article-layout">
    <div>
      {topics.map((topic, i) => (
        <section class="faq-group" id={`topic-${i}`}>
          <h2>{topic}</h2>
          <div class="faq-list">
            {faqs
              .filter((f) => f.data.topic === topic)
              .map((f) => (
                <details id={`faq-${f.id}`}>
                  <summary>
                    {f.data.title}
                    <Icon name="chevron" size={19} />
                  </summary>
                  <div class="faq-answer">
                    <p>{f.body}</p>
                  </div>
                </details>
              ))}
          </div>
        </section>
      ))}
    </div>
    <aside class="article-aside">
      <div class="aside-card">
        <h2>Быстрая навигация</h2>
        <ul>
          {topics.map((t, i) => (
            <li>
              <a href={`#topic-${i}`}>{t}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="aside-card">
        <h3>Не нашли ответ?</h3>
        <p>Начните с инструкций или обратитесь к нам.</p>
        <button class="button button-secondary" data-support>
          Задать вопрос
        </button>
      </div>
    </aside>
  </div>
</Layout>
