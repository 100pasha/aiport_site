---
import { withBase } from '../../lib/config';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
const articles = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  title="Блог — о данных, ИИ и спокойном управлении"
  description="Практические статьи: реальная прибыль, утренняя сводка и безопасное подключение ИИ к бизнесу."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">РАЗБИРАЕМСЯ ПО ДЕЛУ</span>
      <h1>
        Больше ясности.
        <br />
        Меньше шума.
      </h1>
      <p>О данных, ИИ и привычке управлять бизнесом по цифрам.</p>
    </div>
  </section>
  <section class="section section-top">
    <div class="container">
      <div class="blog-grid">
        {articles.map((article) => (
          <BlogCard article={article} />
        ))}
      </div>
      <a class="text-link" href={withBase('/rss.xml')} style="margin-top:30px">
        Читать через RSS →
      </a>
    </div>
  </section>
</Layout>
