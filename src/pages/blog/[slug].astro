---
import { withBase, absoluteUrl } from '../../lib/config';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import BlogCard from '../../components/BlogCard.astro';
import { config } from '../../lib/config';
export async function getStaticPaths() {
  return (await getCollection('blog')).map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}
const { article: a } = Astro.props;
const { Content, headings } = await render(a);
const related = (await getCollection('blog')).filter((x) => x.id !== a.id).slice(0, 2);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.data.title,
  description: a.data.description,
  datePublished: a.data.date.toISOString(),
  image: absoluteUrl(a.data.cover),
  author: { '@type': 'Organization', name: config.brand },
  publisher: { '@type': 'Organization', name: config.brand },
};
---

<Layout title={a.data.title} description={a.data.description} schema={schema} image={a.data.cover}>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Хлебные крошки">
        <a href={withBase('/blog/')}>Блог</a>
        <span>/</span>
        <span>{a.data.tags[0]}</span>
      </nav>
      <h1>{a.data.title}</h1>
      <p>{a.data.description}</p>
      <div class="blog-card-meta" style="margin-top:22px">
        Редакция {config.brand} ·{' '}
        <time datetime={a.data.date.toISOString()}>
          {a.data.date.toLocaleDateString('ru-RU', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
            timeZone: 'Europe/Moscow',
          })}
        </time>
      </div>
    </div>
  </section>
  <div class="container article-layout">
    <article class="prose">
      <img
        class="article-cover"
        src={withBase(a.data.cover)}
        width="720"
        height="460"
        alt={`Иллюстрация: ${a.data.title}`}
      />
      <Content />
    </article>
    <aside class="article-aside">
      <div class="aside-card">
        <h2>В этой статье</h2>
        <ul>
          {headings
            .filter((h) => h.depth === 2)
            .map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
        </ul>
      </div>
      <div class="aside-card">
        <h3>От чтения — к ответам</h3>
        <p>Попробуйте задать вопрос по данным своего бизнеса.</p>
        <CTA block="blog_sidebar" label="Попробовать бесплатно" />
      </div>
    </aside>
  </div>
  <div class="container">
    <section class="final-cta">
      <h2>Ваш первый вопрос — уже хороший старт.</h2>
      <p>Подключите один сервис бесплатно навсегда.</p>
      <CTA block="blog_final" />
    </section>
    <div class="section-heading">
      <span class="eyebrow">ЕЩЁ ПО ТЕМЕ</span>
      <h2>Продолжим разбираться</h2>
    </div>
    <div class="blog-grid" style="padding-bottom:80px">
      {related.map((article) => (
        <BlogCard article={article} />
      ))}
    </div>
  </div>
</Layout>
